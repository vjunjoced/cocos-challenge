# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# URI completa de conexión a PostgreSQL (obligatoria)
DATABASE_URI=postgresql://usuario:contrasena@localhost:5432/nombre_base_de_datos

# Pool de conexiones (opcionales; se muestran los valores por defecto)
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000

# Límite de peticiones por cliente (opcionales; se muestran los valores por defecto)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
